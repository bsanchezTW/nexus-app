{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tw-nexus-app",
          "appId": "1:1001830504530:android:b87d3de8b991817c82278b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tw-nexus-app",
          "configurations": {
            "android": "1:1001830504530:android:b87d3de8b991817c82278b",
            "ios": "1:1001830504530:ios:1bb14f1e6ac3f62382278b",
            "macos": "1:1001830504530:ios:1bb14f1e6ac3f62382278b",
            "web": "1:1001830504530:web:a157fcc7cb90d82e82278b",
            "windows": "1:1001830504530:web:691ad465c13734a282278b"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/.git/**",
      "**/.firebase/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
