<?xml version="1.0" encoding="utf-8"?>
<!-- Icono del splash de Android 12+. Sin color de fondo de icono, el sistema
     lo dibuja en una caja de 288dp y lo recorta a un círculo de 192dp. El
     inset de 40dp deja el logo a 208dp, igual que el splash de Flutter (ver
     SplashScreen): el mark cabe holgado en el círculo y no salta de tamaño ni
     de lugar al pasar al Lottie. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo"
    android:inset="13.89%" />
